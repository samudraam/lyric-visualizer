rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns everything under users/{uid}: songs, mixes.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared lyrics cache is written only by Cloud Functions (Admin SDK
    // bypasses these rules), so clients get no access at all.
    match /lyricsCache/{key} {
      allow read, write: if false;
    }
  }
}
