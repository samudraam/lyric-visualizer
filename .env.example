# Firebase web config for the Vite app. Copy to .env.local (gitignored) and
# fill in: Firebase console → Project settings → Your apps → lyric-bloom-web,
# or `firebase apps:sdkconfig WEB`. The API key must be the restricted one
# described in the "API Keys & Secrets" doc.
#
# These are inlined into the browser bundle: never put a server secret here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lyric-bloom.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lyric-bloom
VITE_FIREBASE_STORAGE_BUCKET=lyric-bloom.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=361284680008
VITE_FIREBASE_APP_ID=1:361284680008:web:3123971c9494dbf0fedb7d

# Set to true to use `firebase emulators:start` instead of the live project.
# VITE_USE_EMULATORS=true
